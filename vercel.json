{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.logicbyte.ai" }],
      "destination": "https://logicbyte.ai/$1",
      "permanent": true
    },
    {
      "source": "/hello-bio",
      "destination": "/contact.html?intent=interest&src=bio-poster",
      "permanent": false
    },
    {
      "source": "/kamal.vcf",
      "destination": "/doorgesh-jokhun.vcf",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/dsj", "destination": "/card.html" }
  ],
  "headers": [
    {
      "source": "/doorgesh-jokhun.vcf",
      "headers": [
        { "key": "Content-Type", "value": "text/vcard; charset=utf-8" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Doorgesh-Jokhun_Logic-Byte.vcf\"" }
      ]
    }
  ]
}
